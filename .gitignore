.env
__pycache__/
*.pyc
.DS_Store

# Local editor/tool state, not part of the project.
.claude/

# ---------------------------------------------------------------------------
# Runtime data: footage in, evidence out. Never committed.
#
# The pattern is `folder/*` plus `!folder/.gitkeep`, not plain `folder/`, and
# the difference matters: `folder/` tells git to ignore the directory itself,
# so git never looks inside it and the `!` exception below can never match.
# `folder/*` ignores the *contents* instead, which leaves git free to see the
# .gitkeep and track it.
#
# Why keep the empty folders at all: compose.yaml bind-mounts every one of
# these into the containers. A folder that doesn't exist on a fresh clone gets
# created by Docker as root, which then can't be written to from the host.
# Shipping them empty avoids that entirely.
# ---------------------------------------------------------------------------

# Clips uploaded through /upload-clip, and the test clips analyzed by hand.
uploaded_clips/*
!uploaded_clips/.gitkeep

# Everything the detectors save out.
evidence/detections/*
!evidence/detections/.gitkeep
evidence/live/*
!evidence/live/.gitkeep
evidence/spit/*
!evidence/spit/.gitkeep
evidence/fight/*
!evidence/fight/.gitkeep
evidence/vandalism/*
!evidence/vandalism/.gitkeep
evidence/fall/*
!evidence/fall/.gitkeep

# Recorded camera segments waiting to be analyzed. Deleted automatically once
# each one has been handled - this is a queue, not an archive.
spool/*
!spool/.gitkeep
