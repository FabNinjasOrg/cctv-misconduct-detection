# Secrets. .env.example is committed instead, with the variable names but no values.
.env

# Snapshots the live view saved. Yours, not the repo's - the folder is kept so a
# fresh clone has somewhere to write.
evidence/live_view/*
!evidence/live_view/.gitkeep

# Test clips for checking the detectors still work after a change. Too big for
# git, and they are footage rather than code.
uploaded_clips/*
!uploaded_clips/.gitkeep

# Working frames a detector writes while explaining itself. Created only when
# something is found, safe to delete at any time.
debug/

__pycache__/
*.pyc
.DS_Store
.claude/
