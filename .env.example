# Copy to .env before the first run:   cp .env.example .env
#
# Then load it into your shell before starting the live view:
#
#     set -a && source .env && set +a
#     python -m app.live


# ---------------------------------------------------------------------------
# CAMERA PASSWORD - the only thing most people have to change.
#
# camera.yaml refers to this as ${CAM1_PASSWORD} rather than holding the real
# password, so that file can be committed and shared safely. Put the password
# here exactly as it is, with no quotes and no escaping: the code percent-encodes
# it when building the RTSP URL, so characters like @ : / # are fine as-is.
#
# One line per camera - CAM2_PASSWORD, CAM3_PASSWORD, ... to match camera.yaml.
# ---------------------------------------------------------------------------
CAM1_PASSWORD=


# ---------------------------------------------------------------------------
# TIMEZONE - optional.
#
# Snapshot filenames use your machine's local time, so this only matters if that
# is set to something other than where the camera is. Use a standard zone name,
# e.g. Asia/Kolkata, Europe/London, America/New_York. Leave blank to use the
# machine's own setting.
# ---------------------------------------------------------------------------
TZ=
