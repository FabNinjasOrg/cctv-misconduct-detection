# Copy to .env before the first run:   cp .env.example .env


# ---------------------------------------------------------------------------
# CAMERA PASSWORD - the one thing you normally have to change.
#
# stream.yaml refers to this as ${CAM1_PASSWORD} instead of holding the real
# password, so that file can be committed and shared safely. Put the password
# here exactly as it is, with no quotes and no escaping: the code percent-encodes
# it when building the RTSP URL, so characters like @ : / # are fine as-is.
#
# One line per camera - CAM2_PASSWORD, CAM3_PASSWORD, ... to match stream.yaml.
# ---------------------------------------------------------------------------
CAM1_PASSWORD=


# GEMINI_KEY is REQUIRED for the app to start, even though nothing the container
# runs actually calls Gemini. The chain is:
#     main.py -> app/actions/fight/yolo_detector.py -> app/shared/gemini_review.py
# and app/shared/gemini_review.py reads os.environ["GEMINI_KEY"] at module level, so an
# unset value raises KeyError during import and uvicorn never comes up.
#
# Any non-empty placeholder is enough to boot. Put a real key here only if the
# Gemini review step inside app/actions/fight/yolo_detector.py is ever uncommented.
GEMINI_KEY=placeholder-not-used

# Not read by any code path the container runs.
OPENAI_API_KEY=
ROBOFLOW_API_KEY=
